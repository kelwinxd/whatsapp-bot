# Configuração do container da Evolution API (docker-compose.yml desta pasta).
# Copie para .env e troque as senhas antes de subir.

# Chave global da API: usada para criar/gerenciar instâncias e para entrar no
# painel em http://localhost:8080/manager. É ela que vai em EVOLUTION_API_KEY
# no .env do bot.
AUTHENTICATION_API_KEY=troque-esta-chave

SERVER_URL=http://localhost:8080

# Banco (o serviço postgres deste compose)
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:troque-esta-senha@postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_wp_bot
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# Cache (o serviço redis deste compose)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution_wp_bot
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# Log enxuto. Para depurar a conexão, acrescente DEBUG e VERBOSE.
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
