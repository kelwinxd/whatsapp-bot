PORT=3000

# --- Segurança ---
# Segredo exigido no webhook: a URL vira /webhook/<token>, ou mande o token no
# cabeçalho x-webhook-token. Vazio deixa aberto — só em rede local.
WEBHOOK_TOKEN=
# Tetos diários de mensagens respondidas (0 desliga)
LIMITE_POR_CONTATO_DIA=50
LIMITE_GLOBAL_DIA=500

# Qual implementação usar em cada porta (ver src/core/registry.js)
WHATSAPP_PROVIDER=zapi
AI_PROVIDER=openai
HISTORY_STORE=memoria
# Lojas, agenda e preferências: arquivo | postgres
ESTADO_STORE=arquivo

# --- Z-API ---
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Evolution API (só precisa quando WHATSAPP_PROVIDER=evolution) ---
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
# whisper-1 (US$ 0,006/min) ou gpt-4o-mini-transcribe (metade)
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Detalhe da imagem: low (barato, visão geral) | high (lê letra miúda) | auto
OPENAI_IMAGE_DETAIL=auto

# --- Banco (histórico que sobrevive a restart) ---
# memoria | postgres. Em postgres, rode antes: npm run migrar
HISTORY_STORE=memoria
# Lojas, agenda e preferências: arquivo | postgres
ESTADO_STORE=arquivo
DATABASE_URL=postgresql://usuario:senha@localhost:5434/wpbot

MAX_HISTORICO=10

# Número usado por "npm run enviar" (DDI+DDD+número, só dígitos)
# Atalhos de telefone no painel: "Nome=numero", separados por ; ou vírgula
CONTATOS=Kelwin=5519999999999;Casa=5511888888888

NUMBER_TEST=5519993723677

# Perfil: loja_<slug> (uma loja cadastrada) | loja | suplementos | whatsapp | puro
# Ex.: PROMPT_PERFIL=loja_sara-modas — veja os slugs em /painel/loja.html
# puro = nenhuma instrução nossa, o modelo cru
PROMPT_PERFIL=suplementos
# Tamanho pedido no prompt (0 desliga a instrução)
RESPOSTA_MAX_PALAVRAS=60
# Quantas mensagens o bot pode mandar por resposta (1 = mensagem única)
RESPOSTA_MAX_MENSAGENS=3
# Texto próprio; quando preenchido, ignora o perfil acima
# SYSTEM_PROMPT=

# Ritmo do "digitando...": maior = digita mais devagar
DIGITANDO_MS_POR_CARACTERE=45
DIGITANDO_MIN_MS=1000
DIGITANDO_MAX_MS=5000
PAUSA_ENTRE_MENSAGENS_MS=800

# --- RAG (responder com base em documentos) ---
# nenhum desliga; memoria guarda em dados/base.json
# Escolhas feitas no painel (perfil ativo); vence o PROMPT_PERFIL acima
PREFERENCIAS_ARQUIVO=dados/preferencias.json

# Pasta com as lojas cadastradas (uma por arquivo)
LOJAS_PASTA=dados/lojas

RAG_PROVIDER=nenhum
RAG_ARQUIVO=dados/base.json
# Distância máxima para o trecho contar como relevante (0 a 2)
RAG_LIMIAR=0.65
RAG_TRECHOS=5
# Tamanho dos pedaços em caracteres (~4 por token)
RAG_TAMANHO_PEDACO=900
RAG_SOBREPOSICAO=150
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
